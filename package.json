{
  "name": "@nvl/tag-to-code-lang",
  "version": "1.1.2",
  "description": "Given a language tag, return the corresponding programming language name. For example: `ts` → `TypeScript`.",
  "keywords": [
    "linguist",
    "language",
    "data",
    "programming-languages"
  ],
  "type": "module",
  "author": {
    "name": "N. V. Lang",
    "email": "npm@nvlang.dev",
    "url": "https://nvlang.dev/"
  },
  "license": "MIT",
  "module": "./dist/mod.js",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./package.json": "./package.json"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvlang/tag-to-code-lang.git"
  },
  "bugs": {
    "url": "https://github.com/nvlang/tag-to-code-lang/issues"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit --skipLibCheck",
    "build": "tsdown",
    "test": "vitest run --coverage",
    "prepare": "husky",
    "ci:version": "changeset version && pnpm exec tsx scripts/update-jsr-versions.ts && pnpm install --no-frozen-lockfile && pnpm run format",
    "ci:publish": "pnpm exec tsx scripts/ci-publish.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.17",
    "@vitest/ui": "^4.1.7",
    "commitlint": "^21.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.1",
    "jsr": "^0.14.3",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
